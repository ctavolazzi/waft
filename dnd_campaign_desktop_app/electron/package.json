{
  "name": "dnd-campaign-desktop-app",
  "version": "0.0.1",
  "description": "Self-running, self-monitoring D&D campaign desktop application",
  "main": "main.js",
  "author": "WAFT",
  "productName": "D&D Campaign Desktop App",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "dnd",
    "campaign",
    "desktop"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "build": {
    "appId": "com.waft.dnd-campaign",
    "productName": "D&D Campaign Desktop App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "../backend/**/*",
      "../frontend/build/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
