== 8.1 Basic Algorithm

#algorithm-figure(
  [WAFT Evolution Loop],
  algorithm({
    import algorithmic: *
    
    Function("Evolve", ("population", "generations"), {
      For($i <= "generations"$, {
        Assign[$"fitness"$][$"Evaluate"("population")$]
        Assign[$"parents"$][$"Select"("population", "fitness")$]
        Assign[$"offspring"$][$"Mutate"("parents")$]
        Assign[$"population"$][$"Replace"("population", "offspring")$]
      })
      Return[$"BestIndividual"("population")$]
    })
  })
)

== 8.2 Conditional Logic

#algorithm-figure(
  [Fitness Evaluation],
  algorithm({
    import algorithmic: *
    
    Function("EvaluateFitness", ("agent", "environment"), {
      Assign[$"score"$][$0$]
      For([$"task" in "environment"$], {
        Assign[$"result"$][$"agent.Execute"("task")$]
        If($"result" = "success"$, {
          Assign[$"score"$][$"score" + 1$]
        })
        Else({
          Assign[$"score"$][$"score" - 0.5$]
        })
      })
      Return[$"score"$]
    })
  })
)

