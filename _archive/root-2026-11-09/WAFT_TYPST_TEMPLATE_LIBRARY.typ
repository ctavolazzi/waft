== 4.4 Multi-Agent Architecture

#align(center)[
  #diagram(
    node-stroke: 1pt,
    edge-stroke: 1pt,
    spacing: (15pt, 18pt),
    
    // User
    node((1, 0), [*User*], shape: circle, fill: rgb("#e8f5e9")),
    
