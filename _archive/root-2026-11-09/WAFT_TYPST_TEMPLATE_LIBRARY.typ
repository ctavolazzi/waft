    node((1, 2), [Agent B], shape: rect, fill: rgb("#e3f2fd")),
    node((2, 2), [Agent C], shape: rect, fill: rgb("#e3f2fd")),
    
    // Memory
    node((1, 3), [*Shared Memory*], shape: rect, fill: rgb("#fff3e0")),
    
    // Connections
    edge((1, 0), (1, 1), "<->"),
    edge((1, 1), (0, 2), "->"),
    edge((1, 1), (1, 2), "->"),
    edge((1, 1), (2, 2), "->"),
    edge((0, 2), (1, 3), "<->"),
    edge((1, 2), (1, 3), "<->"),
    edge((2, 2), (1, 3), "<->"),
  )
]

