#import "@preview/aero-check:0.1.1": *

#show: checklist.with(
  title: "Executive Meeting Preparation",
  disclaimer: "Complete 24 hours before meeting. Send materials in advance.",
  style: 1,
)

#topic("Content Preparation")[
  #section("Materials")[
    #step("Agenda finalized and distributed", "Check")
    #step("Presentation slides prepared", "Check")
    #step("Supporting data and metrics ready", "Check")
    #step("Key talking points outlined", "Check")
    #step("Anticipated questions and answers prepared", "Check")
  ]
]

#topic("Logistics")[
  #section("Setup")[
    #step("Meeting room reserved", "Check")
    #step("Video conference link tested", "Check")
    #step("Projector/screen confirmed working", "Check")
    #step("Handouts printed (if needed)", "Check")
    #step("Water/refreshments arranged", "Check")
  ]
]

#colbreak()

#topic("Stakeholder Coordination")[
  #section("Communication")[
    #step("All attendees confirmed", "Check")
    #step("Key stakeholders briefed in advance", "Check")
    #step("Action items from last meeting reviewed", "Check")
    #step("Pre-meeting discussions held", "Check")
  ]
]

#topic("Day Of Meeting")[
  #section("Final Checks")[
    #step("Arrive 15 minutes early", "Check")
    #step("Test all technology", "Check")
    #step("Review key points one more time", "Check")
    #step("Have backup plan for tech issues", "Check")
    #step("Prepare to take notes", "Check")
  ]
]
