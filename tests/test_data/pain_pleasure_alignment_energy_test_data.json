  "test_formulas": {
    "stamina_modulation_pleasure": {
      "formula": "effective_pleasure = total_pleasure * (stamina_ratio * 0.5 + 0.5)",
      "example": {
        "total_pleasure": 0.8,
        "stamina_ratio": 0.25,
        "calculation": "0.8 * (0.25 * 0.5 + 0.5) = 0.8 * 0.625 = 0.5",
        "effective_pleasure": 0.5
      }
    },
    "stamina_modulation_action_intensity": {
      "formula": "action_intensity = 1.0 - (stamina_ratio * 0.5)",
      "example": {
        "stamina_ratio": 0.2,
        "calculation": "1.0 - (0.2 * 0.5) = 1.0 - 0.1 = 0.9",
        "action_intensity": 0.9,
        "note": "Low stamina = higher intensity (desperate, powerful)"
      }
    },
    "alignment_energy_bonus": {
      "formula": "energy += alignment_score * 1.0",
      "example": {
        "alignment_score": 0.8,
        "base_regeneration": 2.0,
        "bonus": 0.8,
        "total_regeneration": 2.8
      }
    },
    "misalignment_friction": {
      "formula": "will_to_live -= (1.0 - alignment_score) * 0.1",
      "example": {
        "alignment_score": 0.3,
        "misalignment": 0.7,
        "friction": 0.07,
        "will_to_live_loss": 0.07
      }
    },
    "energy_capacity_from_karma": {
      "formula": "energy_capacity = 100.0 + (karma_balance / 100.0) * 50.0",
      "examples": {
        "karma_0": 100.0,
        "karma_500": 350.0,
        "karma_1000": 600.0,
        "karma_2000": 1100.0
      }
    },
    "karma_from_energy": {
      "formula": "karma_generated = energy_spent * 0.1",
      "examples": {
        "energy_10": 1.0,
        "energy_50": 5.0,
        "energy_100": 10.0
      }
    }
  }
