% analysis_orax.sty
% Analysis Report Package for LaTeX
% Provides orange-themed styling and custom commands for analysis reports
%
% Author: WAFT Framework
% Date: 2026/01/16
% Version: 1.0.0

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{analysis_orax}[2026/01/16 v1.0.0 Analysis Report Package]

% ============================================================================
% Required Packages
% ============================================================================

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{titlesec}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage{microtype}

% ============================================================================
% Color Definitions (Orange Theme)
% ============================================================================

% Primary orange color (matching xcolor Orange)
\definecolor{analysisorange}{RGB}{255,153,0}  % #FF9900
\definecolor{analysisdarkorange}{RGB}{204,102,0}  % Darker shade for accents
\definecolor{analysislightorange}{RGB}{255,204,102}  % Lighter shade for backgrounds
\definecolor{analysisgray}{RGB}{128,128,128}  % Neutral gray for text

% ============================================================================
% Page Layout
% ============================================================================

% Default geometry (can be overridden)
\geometry{
    a4paper,
    left=1in,
    right=1in,
    top=1in,
    bottom=1in,
    headheight=14pt,
    footskip=30pt
}

% ============================================================================
% Typography Settings
% ============================================================================

% Section formatting with orange accents
\titleformat{\section}
    {\Large\bfseries\color{analysisorange}}
    {}
    {0em}
    {}
    [\titlerule[0.4pt]]

\titleformat{\subsection}
    {\large\bfseries\color{analysisdarkorange}}
    {}
    {0em}
    {}

\titleformat{\subsubsection}
    {\normalsize\bfseries\itshape\color{analysisdarkorange}}
    {}
    {0em}
    {}

% Spacing for sections
\titlespacing*{\section}{0pt}{0.5in}{0.3in}
\titlespacing*{\subsection}{0pt}{0.3in}{0.15in}
\titlespacing*{\subsubsection}{0pt}{0.2in}{0.1in}

% ============================================================================
% Caption Styling
% ============================================================================

% Configure caption package for orange-colored captions
\captionsetup{
    labelfont={bf,color=analysisorange},
    textfont={color=analysisgray},
    format=hang,
    justification=centering,
    labelsep=colon
}

% Custom caption command for figures
\newcommand{\analysiscaption}[1]{%
    \caption{\textcolor{analysisorange}{\textbf{#1}}}%
}

% ============================================================================
% Figure Environment Enhancement
% ============================================================================

% Custom figure environment with orange styling
\newenvironment{analysisfigure}[1][htb]{%
    \begin{figure}[#1]%
    \centering%
}{%
    \end{figure}%
}

% Convenience command for analysis figures
\newcommand{\analysisfigure}[4][htb]{%
    \begin{analysisfigure}[#1]%
        \includegraphics[width=#2]{#3}%
        \analysiscaption{#4}%
    \end{analysisfigure}%
}

% ============================================================================
% Header and Footer
% ============================================================================

% Page style with orange accents
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\textcolor{analysisorange}{\textbf{Analysis Report}}}
\fancyhead[R]{\textcolor{analysisgray}{\thepage}}
\fancyfoot[C]{\textcolor{analysisgray}{\small Analysis Report}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{analysisorange}\leaders\hrule height \headrulewidth\hfill}}

% ============================================================================
% Hyperref Configuration
% ============================================================================

\hypersetup{
    colorlinks=true,
    linkcolor=analysisorange,
    urlcolor=analysisorange,
    citecolor=analysisdarkorange,
    filecolor=analysisorange,
    pdfborder={0 0 0}
}

% ============================================================================
% Custom Commands
% ============================================================================

% Highlight text with orange background
\newcommand{\highlight}[1]{%
    \colorbox{analysislightorange}{#1}%
}

% Emphasize text in orange
\newcommand{\emphasize}[1]{%
    \textcolor{analysisorange}{\textbf{#1}}%
}

% Analysis section command
\newcommand{\analysissection}[1]{%
    \section{#1}%
}

% Analysis subsection command
\newcommand{\analysissubsection}[1]{%
    \subsection{#1}%
}

% ============================================================================
% Graphics Path
% ============================================================================

% Default graphics path (can be overridden)
\graphicspath{{figures/}{images/}{./}}

% ============================================================================
% End of Package
% ============================================================================
