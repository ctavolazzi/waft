{
  "name": "recap-review-app",
  "version": "1.0.0",
  "description": "Electron app for Recap and Review mindspace documentation",
  "main": "src/main.js",
  "author": "WAFT",
  "productName": "Recap and Review",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "recap",
    "review",
    "mindspace"
  ],
  "author": "WAFT",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "build": {
    "appId": "com.waft.recap-review",
    "productName": "Recap and Review",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
