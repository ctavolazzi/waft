{
  "name": "waft-desktop",
  "version": "0.0.1",
  "description": "WAFT Desktop Application - Electron wrapper for Wave Agent Framework & Tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "waft",
    "electron",
    "desktop",
    "ai",
    "framework"
  ],
  "author": "WAFT Development System",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.waft.desktop",
    "productName": "WAFT Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
