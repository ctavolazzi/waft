    "@testing-library/svelte": "^4.0.5",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^23.2.0",
    "mkcert": "^3.2.0",
    "postcss": "^8.4.33",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "@types/three": "^0.183.1",
